# Legacy demo storage only; not required for Supabase organisation accounts.
# On Vercel, the SDK can use BLOB_STORE_ID and the rotating VERCEL_OIDC_TOKEN.
# For local testing against Blob, set a private read-write token in .env.local.
BLOB_READ_WRITE_TOKEN=

# Supabase public project configuration. Never use a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional Cloudinary signed uploads; keep the API secret server-only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
